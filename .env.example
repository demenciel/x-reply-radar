# Copy to .dev.vars for Wrangler local development. Never commit .dev.vars.
TWITTERAPI_IO_KEY="replace-me"
RESEND_API_KEY="replace-me"
LLM_API_KEY="replace-me"
ADMIN_TOKEN="replace-with-a-random-token-at-least-32-characters"
EMAIL_FROM="X Reply Radar <radar@your-verified-domain.com>"
EMAIL_TO="you@example.com"
# Runtime variables default to wrangler.toml; override locally here as needed.
X_REPLY_RADAR_ENABLED="false"
WATCHED_ACCOUNTS='["levelsio"]'
ACTIVE_HOURS_ENABLED="false"
